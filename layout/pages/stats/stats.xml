<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>

	<scripts>
		<include type="module" src="file://{scripts}/pages/stats/stats.ts" />
	</scripts>

	<!-- Extra right padding (4-value: top right bottom left) keeps content clear of the collapsed right-side drawer handle. -->
	<Panel class="mainmenu__page" style="flow-children: down; padding: 20px 76px 40px 40px;" onload="StatsHandler.onLoad()">
		<!-- Header: title + preload/rescan -->
		<Panel style="flow-children: right; margin-bottom: 10px; width: 100%;">
			<Image src="file://{images}/stats.svg" textureheight="40" style="width: 40px; height: 40px; margin-right: 14px; vertical-align: center;" />
			<Label text="Completion" style="font-size: 36px; font-weight: bold; color: #ffffff; vertical-align: center;" />
			<Panel class="w-fill" />
			<Button id="StatsPreloadToggle" class="button" onactivate="StatsHandler.togglePreload()" onmouseover="UiToolkitAPI.ShowTextTooltip('StatsPreloadToggle', 'Pre-scan this page in the background when the main menu loads so it opens instantly')" onmouseout="UiToolkitAPI.HideTextTooltip()" style="vertical-align: center; padding: 9px 20px; margin-right: 8px; background-color: #232a33; border-radius: 6px;">
				<Label id="StatsPreloadLabel" text="Preload: Off" style="font-size: 15px; color: #ffffff;" />
			</Button>
			<Button class="button" onactivate="StatsHandler.rescan()" style="vertical-align: center; padding: 9px 20px; background-color: #232a33; border-radius: 6px;">
				<Label text="Rescan" style="font-size: 15px; color: #ffffff;" />
			</Button>
		</Panel>

		<!-- Player search (view another user, live from the API — blank = you) on the left, and the
		     ranked/unranked/both filter on the right, sharing one level. -->
		<Panel style="flow-children: right; margin-bottom: 12px; width: 100%; vertical-align: center;">
			<Label text="Player" style="font-size: 14px; color: #8a93a0; vertical-align: center; margin-right: 12px;" />
			<TextEntry id="StatsUserSearch" class="textentry" maxchars="120" placeholder="Steam ID / name / profile URL — blank = you" ontextentrysubmit="StatsHandler.searchUser()" style="width: 380px; vertical-align: center; margin-right: 8px;" />
			<Button class="button" onactivate="StatsHandler.searchUser()" style="vertical-align: center; padding: 9px 20px; background-color: #1c2b30; border: 1px solid #2a3f45; border-radius: 6px; margin-right: 8px;">
				<Label text="View" style="font-size: 15px; color: #6fe0d0;" />
			</Button>
			<Button class="button" onactivate="StatsHandler.resetUser()" style="vertical-align: center; padding: 9px 20px; background-color: #232a33; border-radius: 6px;">
				<Label text="Me" style="font-size: 15px; color: #ffffff;" />
			</Button>
			<Label id="StatsUserStatus" text="" style="font-size: 14px; color: #8a93a0; vertical-align: center; margin-left: 16px;" />
			<Panel class="w-fill" />
			<Panel id="StatsFilter" style="flow-children: right; vertical-align: center;" />
		</Panel>

		<Label id="StatsStatus" text="Loading&#8230;" style="font-size: 15px; color: #8a93a0; margin-bottom: 12px;" />

		<!-- Gamemode selector bar (filled from TS). The per-mode style selector now lives in the right card's sub-left. -->
		<Panel id="StatsGamemodeBar" style="flow-children: right; width: 100%; overflow: scroll noclip; margin-bottom: 12px;" />

		<!-- Selected gamemode content: left stats + right tiers (filled from TS) -->
		<!-- clip (not scroll/noclip): bounds the cards' height:100% and prevents the whole page from scrolling; only the tier map box scrolls. -->
		<Panel id="StatsContent" style="flow-children: right; width: 100%; height: fill-parent-flow(1); overflow: squish clip;" />
	</Panel>
</root>
